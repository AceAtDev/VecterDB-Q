# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Embeddings: auto uses Cohere when COHERE_API_KEY is set, otherwise the local
# all-MiniLM-L6-v2 model (pip install -r requirements-local.txt). Options: auto, cohere, local
EMBEDDING_PROVIDER=auto
COHERE_API_KEY=

# Database Configuration
PERSISTENCE_ENABLED=true
PERSISTENCE_PATH=/app/data/vectordb.pkl
# Checkpoint interval in seconds (not used yet: indexes are rebuilt from chunks on startup)
CHECKPOINT_INTERVAL=300

# Logging
LOG_LEVEL=INFO

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
